# Enter your code here. Read input from STDIN. Print output to STDOUT
def spiral_order_print():
    import sys

    input_data = sys.stdin.read().split()
    if not input_data:
        return

    n = int(input_data[0])
    m = int(input_data[1])

    # Build the matrix from input elements
    matrix = []
    idx = 2
    for i in range(n):
        row = []
        for j in range(m):
            row.append(int(input_data[idx]))
            idx += 1
        matrix.append(row)

    # Initialize boundaries
    top = 0
    bottom = n - 1
    left = 0
    right = m - 1
    result = []

    while top <= bottom and left <= right:
        # 1. Left to Right across the top row
        for i in range(left, right + 1):
            result.append(matrix[top][i])
        top += 1

        # 2. Top to Bottom along the right column
        for i in range(top, bottom + 1):
            result.append(matrix[i][right])
        right -= 1

        # 3. Right to Left across the bottom row
        if top <= bottom:
            for i in range(right, left - 1, -1):
                result.append(matrix[bottom][i])
            bottom -= 1

        # 4. Bottom to Top along the left column
        if left <= right:
            for i in range(bottom, top - 1, -1):
                result.append(matrix[i][left])
            left += 1

    # Print elements separated by spaces
    print(*(result))


if __name__ == "__main__":
    spiral_order_print()
