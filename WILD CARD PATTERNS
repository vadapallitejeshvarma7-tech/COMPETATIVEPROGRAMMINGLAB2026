#include <iostream>
#include <string>

using namespace std;

int isMatch(const string& s, const string& p) {
    int s_ptr = 0, p_ptr = 0;
    int star_idx = -1, s_tmp_idx = -1;
    int n = s.length(), m = p.length();

    while (s_ptr < n) {
        if (p_ptr < m && (p[p_ptr] == '?' || p[p_ptr] == s[s_ptr])) {
            s_ptr++;
            p_ptr++;
        } else if (p_ptr < m && p[p_ptr] == '*') {
            star_idx = p_ptr;
            s_tmp_idx = s_ptr;
            p_ptr++;
        } else if (star_idx != -1) {
            p_ptr = star_idx + 1;
            s_tmp_idx++;
            s_ptr = s_tmp_idx;
        } else {
            return 0;
        }
    }

    while (p_ptr < m && p[p_ptr] == '*') {
        p_ptr++;
    }

    return (p_ptr == m) ? 1 : 0;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    string s, p;
    if (cin >> s >> p) {
        cout << isMatch(s, p) << "\n";
    }

    return 0;
}

