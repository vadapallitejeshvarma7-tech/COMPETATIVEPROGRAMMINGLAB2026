
def solve():
    import sys
   
    S = sys.stdin.read().strip()
    if not S:
        return
        
    n = len(S)
    
  
    pi = [0] * n
    for i in range(1, n):
        j = pi[i - 1]
        while j > 0 and S[i] != S[j]:
            j = pi[j - 1]
        if S[i] == S[j]:
            j += 1
        pi[i] = j
        
 
    longest_prefix_suffix = pi[n - 1]
    
   
    p = n - longest_prefix_suffix
    
   
    if n % p == 0:
        print(p)
    else:
        print(n)

if __name__ == '__main__':
    solve()
