#include <bits/stdc++.h>
using namespace std;

vector<int> countingSort(vector<int> arr) {
    vector<int> count(100, 0);
    vector<int> result;

    for (int x : arr)
        count[x]++;

    for (int i = 0; i < 100; i++) {
        while (count[i]--) {
            result.push_back(i);
        }
    }

    return result;
}

int main() {
    int n;
    cin >> n;

    vector<int> arr(n);
    for (int i = 0; i < n; i++)
        cin >> arr[i];

    vector<int> result = countingSort(arr);

    for (int x : result)
        cout << x << " ";

    return 0;
}
