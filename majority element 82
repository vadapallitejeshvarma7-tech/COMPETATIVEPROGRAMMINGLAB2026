import sys

def majorityElement(arr):
    n = len(arr)
    if n == 0:
        return -1
        
    
    candidate = arr[0]
    count = 1
    
    for i in range(1, n):
        if count == 0:
            candidate = arr[i]
            count = 1
        elif arr[i] == candidate:
            count += 1
        else:
            count -= 1
            
    
    if arr.count(candidate) > n // 2:
        return candidate
        
    return -1

def main():
    
    input_data = sys.stdin.read().split()
    if not input_data:
        return
        
    n = int(input_data[0])
    arr = [int(x) for x in input_data[1:n+1]]
    
    print(majorityElement(arr))

if __name__ == '__main__':
    main()
