import sys

def find_unique_triplets():
    input = sys.stdin.read
    data = input().split()
    
    if not data:
        return
        
    n = int(data[0])
    
    a = [int(x) for x in data[1:n+1]]
    
    x = int(data[n+1])
    

    a.sort()
    found = False
    
    
    for i in range(n - 2):
        
        if i > 0 and a[i] == a[i - 1]:
            continue
            
        left = i + 1
        right = n - 1
        
        while left < right:
            s = a[i] + a[left] + a[right]
            
            if s == x:
                print(f"{a[i]} {a[left]} {a[right]}")
                found = True
                
                
                while left < right and a[left] == a[left + 1]:
                    left += 1
                while left < right and a[right] == a[right - 1]:
                    right -= 1
                    
                left += 1
                right -= 1
            elif s < x:
                left += 1
            else:
                right -= 1
                
    if not found:
        print("No Triplet Found")

if __name__ == '__main__':
    find_unique_triplets()
