import sys
from collections import deque


def solve():
  input_data = sys.stdin.read().split()
  if not input_data:
    return

  iterator = iter(input_data)

 
  tokens = list(iterator)
  idx = 0
  n_tokens = len(tokens)

  if n_tokens == 0:
    return

  
  while idx < n_tokens:
 
    if idx == 0:
    
      first_val = int(tokens[idx])
      idx += 1

  
      
      if idx < n_tokens:
        second_val = int(tokens[idx])
      
        if first_val * second_val + 1 == n_tokens - idx:
          
          N = first_val
          M = second_val
          idx += 1
          run_bfs(N, M, tokens, idx)
          idx += N * M
          continue
        else:
         
          T = first_val
         
          for _ in range(T):
            if idx >= n_tokens:
              break
            N = int(tokens[idx])
            M = int(tokens[idx + 1])
            idx += 2
            run_bfs(N, M, tokens, idx)
            idx += N * M
          break


def run_bfs(N, M, tokens, start_idx):
  grid = []
  queue = deque()
  fresh_count = 0

  curr = start_idx
  for i in range(N):
    row = []
    for j in range(M):
      val = int(tokens[curr])
      curr += 1
      row.append(val)
      if val == 2:
        queue.append((i, j, 0)) 
      elif val == 1:
        fresh_count += 1
    grid.append(row)

  if fresh_count == 0:
    print(0)
    return

  max_time = 0
  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]

  while queue:
    r, c, time = queue.popleft()
    max_time = max(max_time, time)

    for dr, dc in directions:
      nr, nc = r + dr, c + dc
      if 0 <= nr < N and 0 <= nc < M and grid[nr][nc] == 1:
        grid[nr][nc] = 2
        fresh_count -= 1
        queue.append((nr, nc, time + 1))

  if fresh_count == 0:
    print(max_time)
  else:
    print(-1)


if __name__ == "__main__":
  solve()
