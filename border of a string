def find_longest_border(s: str) -> str:
    n = len(s)
    if n <= 1:
        return ""
        
    lps = [0] * n
    length = 0
    i = 1

    while i < n:
        if s[i] == s[length]:
            length += 1
            lps[i] = length
            i += 1
        else:
            if length != 0:
                length = lps[length - 1]
            else:
                lps[i] = 0
                i += 1
                
    border_len = lps[-1]
    return s[:border_len] if border_len > 0 else ""

if __name__ == "__main__":
    import sys
    
    input_string = sys.stdin.read().strip()
    if input_string:
        print(find_longest_border(input_string))
